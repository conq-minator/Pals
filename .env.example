# PALS Environment Configuration Template
# Copy this file to .env and provide your secret keys and configurations.
# NEVER COMMIT .env TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# System & Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
PALS_LOG_LEVEL=info
PALS_API_PORT=8000
PALS_FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Shared Storage & Message Broker (Phase 1)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://pals_user:pals_password@localhost:5432/pals_db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Shared LLM Provider Configuration
# -----------------------------------------------------------------------------
# Primary LLM Provider (openai | anthropic | gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Assignments
MODEL_GLY_GATEWAY=gemini-2.5-flash
MODEL_GLY_RAG=gemini-2.5-flash
MODEL_ARB_REASONING=gemini-2.5-pro
MODEL_ARB_FAST=gemini-2.5-flash
MODEL_DEFENDER_EVALUATOR=gemini-2.5-pro

# -----------------------------------------------------------------------------
# GLY: Knowledge Base & Vector Store
# -----------------------------------------------------------------------------
VECTOR_DB_TYPE=pgvector
VECTOR_DB_URL=postgresql://pals_user:pals_password@localhost:5432/pals_vectors
EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# ARB: Web Navigation & Research Services
# -----------------------------------------------------------------------------
HEADLESS_BROWSER_WS_ENDPOINT=
SERP_API_KEY=
PROXY_ROTATION_URL=

# -----------------------------------------------------------------------------
# PULSE: PayPal Integration
# -----------------------------------------------------------------------------
# Options: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# -----------------------------------------------------------------------------
# DEFENDER: Transaction Security (Phase 4 Placeholder)
# -----------------------------------------------------------------------------
DEFENDER_ENABLED=false
DEFENDER_RISK_THRESHOLD=0.75

