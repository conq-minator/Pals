# PALS Environment Configuration Template
# Copy this file to .env and provide your secret keys and configurations.
# NEVER COMMIT .env TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# System & Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
PALS_LOG_LEVEL=info
PALS_API_PORT=8000
PALS_FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Shared Storage & Message Broker (Phase 1)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://pals_user:pals_password@localhost:5432/pals_db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Shared LLM Provider Configuration
# -----------------------------------------------------------------------------
# Primary LLM Provider (openai | anthropic | gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Assignments
MODEL_GLY_GATEWAY=gemini-2.5-flash
MODEL_GLY_RAG=gemini-2.5-flash
MODEL_ARB_REASONING=gemini-2.5-pro
MODEL_ARB_FAST=gemini-2.5-flash
MODEL_DEFENDER_EVALUATOR=gemini-2.5-pro

# -----------------------------------------------------------------------------
# GLY: Knowledge Base & Vector Store
# -----------------------------------------------------------------------------
VECTOR_DB_TYPE=pgvector
VECTOR_DB_URL=postgresql://pals_user:pals_password@localhost:5432/pals_vectors
EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# ARB: Web Navigation & Research Services
# -----------------------------------------------------------------------------
# Recommended for server/cloud deployments where bot-protection blocks direct scraping:
# - Brave Search API (free tier at https://brave.com/search/api/):
BRAVE_SEARCH_API_KEY=
# - Serper Google Search API (free tier at https://serper.dev):
SERPER_API_KEY=
SERP_API_KEY=
# - SerpAPI (https://serpapi.com):
SERPAPI_API_KEY=
# - Google Custom Search JSON API:
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
HEADLESS_BROWSER_WS_ENDPOINT=
PROXY_ROTATION_URL=

# -----------------------------------------------------------------------------
# PULSE: PayPal Integration
# -----------------------------------------------------------------------------
# Options: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# -----------------------------------------------------------------------------
# Full system (npm start): GLY + ARB + DEFENDER + PULSE in one process
# -----------------------------------------------------------------------------
# Where the browser reaches the server. PayPal sends the buyer back to
# <PALS_PUBLIC_URL>/paypal/return, so it must be reachable from the buyer's browser.
PALS_PUBLIC_URL=http://localhost:8000
# Used when the user names no currency.
PALS_DEFAULT_CURRENCY=USD
# PayPal cannot charge INR. Offers researched in such a currency are re-quoted in this one.
PALS_SETTLEMENT_CURRENCY=USD
# Signs approval tokens. Random per start when empty.
PALS_APPROVAL_SECRET=
# GLY chat model: "gemini" (uses GEMINI_API_KEY above) or "anthropic" (uses ANTHROPIC_API_KEY)
GLY_LLM_PROVIDER=gemini
# "sentence-transformer" (default, local, downloads ~35 MB once), "voyage", or "hash" (tests only)
# GLY_EMBEDDER=sentence-transformer

# -----------------------------------------------------------------------------
# DEFENDER: Transaction Security (Phase 4 Placeholder)
# -----------------------------------------------------------------------------
DEFENDER_ENABLED=false
DEFENDER_RISK_THRESHOLD=0.75

