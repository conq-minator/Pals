# Copy this file to .env and fill in your own values:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored and loaded automatically by every npm script.
# This example file IS committed, so never put a real key in it.
#
# Only GEMINI_API_KEY is required. Everything else is optional: remove the "#"
# to override a default. Leave a line commented rather than empty, because
# an empty value can replace a default with nothing.

# ---------- LLM (required) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# "gemini" (default) or "anthropic"
# GLY_LLM_PROVIDER=gemini
# Only needed when GLY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Defaults are set in GLY/config.ts
# GLY_INTENT_MODEL=
# GLY_ANSWER_MODEL=

# ---------- Embeddings ----------
# "sentence-transformer" (default, free, local), "voyage", or "hash" (tests only)
# GLY_EMBEDDER=sentence-transformer
# GLY_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Only needed when GLY_EMBEDDER=voyage
# VOYAGE_API_KEY=

# ---------- Vector database ----------
# Postgres with pgvector. Without it, the in-memory store cached in .cache/ is used.
# DATABASE_URL=postgres://user:password@localhost:5432/gly

# ---------- Tuning (defaults shown) ----------
# GLY_PORT=8787
# Default: the embedder's suggestion (0.6 for BGE)
# GLY_RAG_SCORE_MIN=0.6
# GLY_RAG_TOP_K=8
# GLY_INTENT_CONFIDENCE_MIN=0.6
# GLY_HISTORY_TURNS=10
# GLY_CALL_ACK_TIMEOUT_MS=3000
# GLY_STALE_TASK_MS=300000
# How long the fake ARB/PULSE take in the demo
# GLY_FAKE_WORK_MS=4000
# debug | info | warn | error | silent
# LOG_LEVEL=info
