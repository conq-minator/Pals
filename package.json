{
  "name": "pals-monorepo",
  "version": "1.0.0",
  "description": "PALS \u2014 Personal AI Life & Shopping Companions",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix GLY && npm install --prefix frontend",
    "start": "tsx shared/orchestrator/server.ts",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix GLY",
    "test": "npm run test:ts && npm run test:gly",
    "test:ts": "tsx --test tests/**/*.test.ts",
    "test:system": "tsx --test tests/pals_system.test.ts tests/defender_rules.test.ts",
    "test:gly": "npm test --prefix GLY",
    "defender": "tsx defender/server.ts",
    "defender:demo": "tsx defender/demo.ts",
    "pulse": "tsx PULSE/server.ts",
    "pulse:test": "tsx PULSE/test-payment.ts"
  },
  "keywords": [
    "pals",
    "ai",
    "multi-agent",
    "paypal",
    "commerce",
    "shopping"
  ],
  "author": "PALS Engineering Council",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
}
