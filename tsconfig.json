{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "rootDir": "./",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "shared/**/*",
    "GLY/**/*",
    "ARB/**/*",
    "PULSE/**/*",
    "defender/**/*",
    "tests/**/*",
    "calls/**/*"
  ],
  "exclude": [
    "node_modules",
    "GLY/node_modules",
    "dist"
  ]
}
